{
  "extends": [
    "next/core-web-vitals",
    "next/typescript",
    "airbnb-base",
    "plugin:prettier/recommended"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": "warn",
    "import/extensions": "off",
    "linebreak-style": ["off"],
    "camelcase": ["error", { "allow": ["Josefin_Sans"] }]
  }
}
